# Django
SECRET_KEY=your-super-secret-key-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# CORS - Add your frontend GitHub Pages URL
CORS_ALLOWED_ORIGINS=https://username.github.io,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://username.github.io,http://localhost:5173,http://127.0.0.1:5173

# Database - use Render Internal Database URL in production
DATABASE_URL=postgresql://user:password@host:5432/database

# HTTPS/security defaults are enabled automatically when DEBUG=False.
# Override only if Render/custom domain setup requires it.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
